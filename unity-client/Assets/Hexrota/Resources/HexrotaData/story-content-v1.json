  "nodes": [
    {"id":"a-intro","chapterId":"wood","speakerId":"tavik","text":"Şu kutulardaki tahtalar işimize yarayacak. Önce onları bir araya getirelim.","pose":"point","trigger":{"event":"level_started","materialId":null,"subject":null},"conditions":[],"once":true,"priority":100,"order":0,"next":null,"choices":[],"sceneId":null},
    {"id":"a-first-wood","chapterId":"wood","speakerId":"tavik","text":"İlk tahtalar hazır! Sağlam parçaları onarım için saklayalım.","pose":"celebrate","trigger":{"event":"material_collected","materialId":"wood","subject":null},"conditions":[],"once":true,"priority":80,"order":1,"next":null,"choices":[],"sceneId":null},
    {"id":"a-wood-ready","chapterId":"wood","speakerId":"tavik","text":"Bütün tahtaları topladık. Kümesin eksik ahşap parçaları için artık hazırız.","pose":"celebrate","trigger":{"event":"material_goal_completed","materialId":"wood","subject":null},"conditions":[],"once":true,"priority":0,"order":2,"next":null,"choices":[],"sceneId":"coop-frame"},

    {"id":"b-intro","chapterId":"nails","speakerId":"tavik","text":"Tahtaları yerinde tutmak için çivilere ihtiyacımız var. İşaretli yerleri birlikte kontrol edelim.","pose":"point","trigger":{"event":"level_started","materialId":null,"subject":null},"conditions":[],"once":true,"priority":100,"order":0,"next":null,"choices":[],"sceneId":null},
    {"id":"b-first-nail","chapterId":"nails","speakerId":"tavik","text":"Bir çivi bulduk! Küçük ama sağlam bir onarım için çok gerekli.","pose":"celebrate","trigger":{"event":"material_collected","materialId":"nail","subject":null},"conditions":[],"once":true,"priority":80,"order":1,"next":null,"choices":[],"sceneId":null},
    {"id":"b-nails-ready","chapterId":"nails","speakerId":"tavik","text":"Çiviler tamam. Kümesin gevşeyen bağlantılarını artık sağlamlaştırabiliriz.","pose":"celebrate","trigger":{"event":"material_goal_completed","materialId":"nail","subject":null},"conditions":[],"once":true,"priority":0,"order":2,"next":null,"choices":[],"sceneId":"coop-roof"},

    {"id":"c-intro","chapterId":"together","speakerId":"tavik","text":"Bu kez hem tahta hem çivi gerekiyor. Açılan yollardaki parçaları da gözden kaçırmayalım.","pose":"call","trigger":{"event":"level_started","materialId":null,"subject":null},"conditions":[],"once":true,"priority":100,"order":0,"next":null,"choices":[],"sceneId":null},
    {"id":"c-region-found","chapterId":"together","speakerId":"tavik","text":"Geçidin altındaki alan açıldı! Artık oradaki parçalara da ulaşabiliyoruz.","pose":"point","trigger":{"event":"region_opened","materialId":null,"subject":null},"conditions":[],"once":true,"priority":70,"order":1,"next":null,"choices":[],"sceneId":"coop-clearing"},
    {"id":"c-first-wood","chapterId":"together","speakerId":"tavik","text":"İlk tahtaları bulduk. Bunlarla eksik yerleri tamamlayabiliriz.","pose":"point","trigger":{"event":"material_collected","materialId":"wood","subject":null},"conditions":[],"once":true,"priority":80,"order":2,"next":null,"choices":[],"sceneId":null},
    {"id":"c-first-nail","chapterId":"together","speakerId":"tavik","text":"Çiviler de gelmeye başladı. Tahtaları sağlamca tutturmak için onları ayıralım.","pose":"point","trigger":{"event":"material_collected","materialId":"nail","subject":null},"conditions":[],"once":true,"priority":80,"order":3,"next":null,"choices":[],"sceneId":null},
